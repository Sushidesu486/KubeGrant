# Export variables in your shell; the server does not automatically read .env files.
KUBEGRANT_HTTP_ADDR=127.0.0.1:8080
KUBEGRANT_STATIC_DIR=web/dist
KUBEGRANT_DATABASE_PATH=data/kubegrant.db
KUBEGRANT_PUBLIC_URL=http://127.0.0.1:8080

# Configure these to enable real FreeIPA authentication; no bind password is stored.
KUBEGRANT_LDAP_URLS=ldaps://ipa-01.clusters.zjusct.io:636,ldaps://ipa-02.clusters.zjusct.io:636,ldaps://ipa-03.clusters.zjusct.io:636
KUBEGRANT_LDAP_BASE_DN=dc=clusters,dc=zjusct,dc=io
KUBEGRANT_LDAP_CA_FILE=/etc/ipa/ca.crt
KUBEGRANT_ADMIN_GROUPS=admins
KUBEGRANT_SESSION_TTL=30m

# The only assignable pre-existing ClusterRole; members cannot override it.
KUBEGRANT_CLUSTER_ID=zjusct
KUBEGRANT_PERMISSION_REF=cluster-admin
KUBEGRANT_GRANT_MAX_TTL=720h

# Opt-in only after the signing controller, constrained RBAC and admission policies
# are installed. The web process never needs a Kubernetes token or a CA key.
KUBEGRANT_SIGNING_ENABLED=false
KUBEGRANT_CLUSTER_ENDPOINT=https://k8s-api.clusters.zjusct.io:6444
KUBEGRANT_CLUSTER_CA_FILE=/etc/kubegrant/cluster/ca.crt
# Controller-only projected token and API trust bundle (defaults shown).
KUBEGRANT_KUBERNETES_API=https://kubernetes.default.svc
KUBEGRANT_KUBERNETES_CA_FILE=/var/run/kubegrant/api/ca.crt
KUBEGRANT_KUBERNETES_TOKEN_FILE=/var/run/kubegrant/api/token
